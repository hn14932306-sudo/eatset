# Server only. Never include these secrets in Flutter or Git.
GOOGLE_PLACES_API_KEY=
SERVER_SECRET=
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/usage.sqlite
# Development only: set a request limit to 0 to disable it; usage still counts.
# Production requires positive minute and daily limits.
CLIENT_REQUESTS_PER_MINUTE=30
CLIENT_REQUESTS_PER_DAY=150
GOOGLE_REQUESTS_PER_DAY=500
GOOGLE_PHOTO_REQUESTS_PER_DAY=1000
MAX_CONCURRENT_REQUESTS=4
# Exact web origins and trusted reverse-proxy IPs; empty means none.
ALLOWED_ORIGINS=
TRUSTED_PROXY_IPS=
